[device]
# idx_device = 1

[mesh]
x_min         = -0.5  -0.5  -0.5
x_max         =  0.5   0.5   0.5
# n_cell_global =  2048 2048     1

n_cell_global =  512  512   2
n_cell_block  =   64   64   2


[refine_region_00]
level  =  2
x_min  = -0.5   0.20 -0.5
x_max  =  0.5   0.35  0.5

[refine_region_01]
level  =  2
x_min  = -0.5  -0.35 -0.5
x_max  =  0.5  -0.20  0.5

[boundary]
# kinds = fre fre fre fre fre fre
kinds = per per fre fre ref ref

[cycle]
prefix_output  = kh
n_cycle_lim    = 100000000
n_display_freq = 100
t_lim          = 2.4
dt_output      = 2e-1
t_output_next  = 0e0
final_output   = 0

[dynamics]
gamma         = 1.4
thread_limit  = 256

[prob]
# Use default values
